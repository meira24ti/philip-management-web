# Production: serve /api and /uploads through the domain's reverse proxy.
# Pengembangan lokal: jalankan backend di port 5000.
VITE_API_URL=http://localhost:5000/api

# Production satu domain dengan reverse proxy: VITE_API_URL=/api
# Production terpisah: gunakan URL backend HTTPS saat build.
# Local development: VITE_API_URL=http://localhost:5000/api
