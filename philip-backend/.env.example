NODE_ENV=production
PORT=5000
CLIENT_URL=https://philiprealestate.com,https://www.philiprealestate.com
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h

# Set only when the application is reachable through trusted reverse proxies.
# Example for exactly one trusted proxy: TRUST_PROXY=1
TRUST_PROXY=
# Keep Chromium sandbox enabled. Set true only if your isolated container requires it.
PUPPETEER_NO_SANDBOX=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# SMTP configuration for the forgot-password email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Philip Real Estate <no-reply@example.com>
